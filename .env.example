BASE_URL=http://localhost:8000
# FastAPI Configuration
SECRET_KEY=your_super_secret_key_here  # Run openssl rand -hex 32 to generate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 Credentials
# Get these from the GCP Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/google.callback

# Google Cloud Storage (required on Render; optional locally — disk fallback)
# See DEPLOY.md §2 for bucket + service account setup
GCS_BUCKET_NAME=your_bucket_name
GCS_KEY_JSON={"type":"service_account","project_id":"..."}

# Cron + admin (generate with: openssl rand -hex 32)
CRON_SECRET=
ADMIN_PASSWORD=

# Optional first-boot demo user (leave empty in production)
SEED_DEMO_USERNAME=
SEED_DEMO_PASSWORD=

# Database Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://app.xyz
INSTAGRAM_REDIRECT_URI=https://your-ngrok-url.ngrok-free.app/social.instagram.callback
FACEBOOK_REDIRECT_URI=https://your-ngrok-url.ngrok-free.app/social.facebook.callback

# MongoDB Atlas (flat collections: users, clients, channels, videos, topics, content_plans)
MONGODB_URI=
MONGODB_DB_NAME=youtube_analytics

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_REASONING_EFFORT=low
OPENAI_LOG_PATH=log.txt
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_MAPPING_MODEL=gpt-5.6-luna
OPENAI_GENERATION_MODEL=gpt-5.6-luna
OPENAI_CONTENT_PLAN_MODEL=gpt-5.6-luna
OPENAI_CONTENT_PLAN_MAP_EFFORT=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts
YT_METADATA_MODEL=gpt-5.6-luna
YT_METADATA_EFFORT=low
SCRAPE_LOG_PATH=scrape_log.txt

# SerpApi — Google Trends (web + YouTube), region India
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
TRENDS_GEO=IN
TRENDS_LOCATION_NAME=India
TRENDS_TTL_DAYS=7
